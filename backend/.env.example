# Copy this file to .env and add your Open Charge Map API key
# (free key: https://openchargemap.org/site/develop/api)
OCM_API_KEY=your_key_here

# Optional: live charger availability from Google Maps (Places API (New), billing enabled)
GOOGLE_MAPS_API_KEY=

# Built-in simulated charger network: every searched station gets a live (simulated) charger feed.
# 0 switches it off. SIM_SPEED: time acceleration (20 = one real minute is 20 simulated minutes).
SIMULATE_CHARGERS=1
SIM_SPEED=20
SIM_DEMAND=1

# Optional: TomTom developer key (free, no card) - more charging stations across India
TOMTOM_API_KEY=

# Optional: an account that always exists (created again on every start) - useful on free hosting, where the
# database is wiped on restart. Set these on the host (Render -> Environment), not in the code.
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_NAME=

# Optional: PostgreSQL instead of the local SQLite file (needed on hosts that wipe files on restart, e.g. Render free).
# Example (Neon): postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
